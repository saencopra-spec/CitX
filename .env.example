# Cadena de conexion de MongoDB Atlas.
# La copias desde Atlas en: Database > Connect > Drivers.
# Acordate de reemplazar <db_password> por la contrasena real del usuario.
MONGODB_URI="mongodb+srv://usuario:contrasena@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Nombre de la base de datos dentro del cluster.
MONGODB_DB="citx"

# Clave secreta para firmar los tokens de sesion (JWT).
# Genera una nueva con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiame-por-una-clave-larga-y-aleatoria"

# Zona horaria de la aplicacion. No la cambies.
APP_TIMEZONE="America/Costa_Rica"
